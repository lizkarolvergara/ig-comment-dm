# Instagram (Meta for Developers > tu app > Instagram > API setup with Instagram login)
IG_APP_SECRET=            # "Instagram app secret" (no el App Secret de Meta)
IG_VERIFY_TOKEN=          # texto aleatorio que tú eliges, el mismo que pones en el dashboard de webhooks
GRAPH_API_VERSION=v25.0

# Supabase (Project Settings > API). Solo en el servidor, nunca en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protección de endpoints internos
CRON_SECRET=              # Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" en sus crons
STATUS_TOKEN=             # para abrir /api/status?token=...

# Opcional: aviso si algo falla (p. ej. https://ntfy.sh/<tu-tema-secreto>)
ALERT_URL=
DISPLAY_TZ=UTC           # zona horaria para la página de estado, p. ej. America/Lima
