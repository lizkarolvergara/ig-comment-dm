# --- Meta / Instagram (Unified login: Instagram API con inicio de sesión de Facebook) ---
IG_ACCESS_TOKEN=          # token de usuario del sistema (no caduca), generado con tu configuración
IG_USER_ID=               # id de tu cuenta de Instagram (el número bajo tu usuario en el dashboard)
META_APP_SECRET=          # Configuración de la app > Básica > Clave secreta de la app (para firmar webhooks)
IG_VERIFY_TOKEN=          # texto aleatorio que tú eliges, el mismo que pones al configurar el webhook
GRAPH_HOST=graph.facebook.com   # usa graph.instagram.com solo si tu app es de "Instagram Login" (token de 60 días)
GRAPH_API_VERSION=v25.0

# --- Supabase (Project Settings > API Keys). Solo en el servidor. ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Protección de endpoints internos ---
CRON_SECRET=              # Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" en sus crons
ADMIN_PASSWORD=           # contraseña del panel (mínimo 12 caracteres; usa una larga de tu gestor)
SESSION_SECRET=           # texto aleatorio de 32+ caracteres para firmar la sesión (cámbialo para cerrar todas las sesiones)

# --- Opcional ---
ALERT_URL=                # aviso si algo falla, p. ej. https://ntfy.sh/<tu-tema-secreto>
DISPLAY_TZ=America/Lima
POLL_MEDIA_LIMIT=50       # cuántos posts recientes revisa el lector (sin importar su antigüedad)
